<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blink Scroll"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Fais défiler TikTok et Instagram sans les mains."
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 1. Triggers -->
        <TextView
            style="@style/SectionTitle"
            android:text="1 · Déclencheurs" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSound"
            style="@style/SettingSwitch"
            android:layout_marginTop="0dp"
            android:text="Bruit appris (micro)"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/soundSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/soundStatus"
                style="@style/Hint"
                android:text="Pas encore appris" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLearn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Apprendre mon bruit" />

            <TextView
                android:id="@+id/sensitivityLabel"
                style="@style/SliderLabel"
                android:text="Sensibilité : normale" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:value="0"
                android:valueFrom="-10"
                android:valueTo="10" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchProximity"
            style="@style/SettingSwitch"
            android:layout_marginTop="16dp"
            android:text="Main au-dessus du téléphone"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/proximityStatus"
            style="@style/Hint"
            android:text="Passe la main au-dessus du haut de l’écran, à quelques centimètres." />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDouble"
            style="@style/SettingSwitch"
            android:layout_marginTop="16dp"
            android:text="Deux fois de suite = vidéo précédente" />

        <TextView
            style="@style/Hint"
            android:text="Pour le bruit et la main. Une fois = vidéo suivante." />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEyes"
            style="@style/SettingSwitch"
            android:layout_marginTop="16dp"
            android:text="Clin d’œil (caméra)"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/eyesSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/modeWinkAny"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clin d’œil (n’importe quel œil) → suivante" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/modeWinkLeftRight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Œil droit → suivante · œil gauche → précédente" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/modeLongBlink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Yeux fermés longtemps → suivante" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/modeDoubleBlink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Double clignement → suivante" />
            </RadioGroup>

            <TextView
                android:id="@+id/holdLabel"
                style="@style/SliderLabel"
                android:text="Durée du clin d’œil : 250 ms" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="50"
                android:value="250"
                android:valueFrom="150"
                android:valueTo="800" />

            <TextView
                android:id="@+id/thresholdLabel"
                style="@style/SliderLabel"
                android:text="Œil considéré fermé sous : 30 %" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:value="30"
                android:valueFrom="10"
                android:valueTo="50" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSwap"
                style="@style/SettingSwitch"
                android:text="Inverser œil gauche / droit" />
        </LinearLayout>

        <!-- 2. Permissions -->
        <TextView
            style="@style/SectionTitle"
            android:text="2 · Autorisations" />

        <LinearLayout style="@style/SetupRow">

            <TextView
                android:id="@+id/statusAccess"
                style="@style/SetupLabel"
                android:text="Service d’accessibilité" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccess"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activer" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowMic"
            style="@style/SetupRow">

            <TextView
                android:id="@+id/statusMic"
                style="@style/SetupLabel"
                android:text="Micro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMic"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Autoriser" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowCamera"
            style="@style/SetupRow">

            <TextView
                android:id="@+id/statusCamera"
                style="@style/SetupLabel"
                android:text="Caméra" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCamera"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Autoriser" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/restrictedHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Hint"
                android:text="Si l’interrupteur est grisé (« paramètre restreint ») : touche-le une fois, puis infos de l’appli → menu ⋮ → « Autoriser les paramètres restreints »." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppInfo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:text="Ouvrir les infos de l’appli" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="Démarrer"
            android:textSize="18sp"
            app:cornerRadius="32dp" />

        <!-- 3. Live test -->
        <TextView
            style="@style/SectionTitle"
            android:text="3 · Test en direct" />

        <TextView
            android:id="@+id/liveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Détection arrêtée"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="?attr/colorPrimary"
            android:textSize="72sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lastAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="déclenchements"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout
            android:id="@+id/liveSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/EyeLabel"
                android:text="Micro" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressSound"
                style="@style/EyeBar" />

            <TextView
                android:id="@+id/lastSound"
                style="@style/Hint"
                android:text="Aucun bruit détecté pour l’instant" />
        </LinearLayout>

        <TextView
            android:id="@+id/liveProximity"
            style="@style/EyeLabel"
            android:text="Capteur de proximité : —" />

        <LinearLayout
            android:id="@+id/liveEyes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/labelLeft"
                style="@style/EyeLabel"
                android:text="Œil gauche" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressLeft"
                style="@style/EyeBar" />

            <TextView
                android:id="@+id/labelRight"
                style="@style/EyeLabel"
                android:text="Œil droit" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressRight"
                style="@style/EyeBar" />
        </LinearLayout>

        <!-- 4. General -->
        <TextView
            style="@style/SectionTitle"
            android:text="4 · Général" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchOnlyTargets"
            style="@style/SettingSwitch"
            android:layout_marginTop="0dp"
            android:text="Seulement dans TikTok et Instagram" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchVibrate"
            style="@style/SettingSwitch"
            android:text="Vibrer à chaque défilement" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="24dp"
            android:text="Ici, l’appli ne fait que tester : le défilement réel se fait dans TikTok ou Instagram. Micro, capteur et caméra se mettent en veille écran éteint et hors de ces applis. Pour tout arrêter : bouton « Arrêter » ci-dessus ou dans la notification." />
    </LinearLayout>
</ScrollView>
